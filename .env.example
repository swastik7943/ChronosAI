# Database
# Provide your MongoDB Atlas URI here
MONGODB_URI=mongodb://localhost:27017/chronosai

# Backend
PORT=5000
JWT_SECRET=super_secret_jwt_key_chronosai

# AI Service (FastAPI)
AI_SERVICE_URL=http://localhost:8000
# Gemini API Key (get from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Google OAuth2 Credentials (for Calendar Sync)
# Set your redirect URI in Google Cloud Console to http://localhost:5000/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Mailing System (NodeMailer SMTP Credentials)
# E.g., Gmail with App Password or SendGrid
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Frontend
VITE_API_URL=http://localhost:5000
