# --- DATABASE & AUTH ---
MONGODB_URI=mongodb://localhost:27017/chronosai
JWT_SECRET=your_super_secret_key_here
ENCRYPTION_KEY=32_character_long_secret_key_123 # Must be exactly 32 characters (AES-256-GCM key)

# --- DOCKER CONFIG (Used by docker-compose.yml) ---
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=password

# --- RUNTIME ---
PORT=5000
NODE_ENV=development

# --- AI SERVICE ---
# The AI service (ai_service) and the parser load `.env` from the repository root by default.
GEMINI_API_KEY=your_google_ai_studio_api_key   # Shared by both Backend and AI service
AI_SERVICE_URL=http://localhost:8000

# --- GOOGLE CALENDAR INTEGRATION ---
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# --- EMAIL NOTIFICATIONS (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# --- FRONTEND CONFIG (FOR frontend/.env.local) ---
VITE_API_URL=http://localhost:5000
VITE_JITSI_DOMAIN=meet.jit.si
